services:

  backend:
    image: chaitanyathite/gods-eye-backend:latest
    container_name: gods-eye-backend
    restart: unless-stopped

    environment:
      NODE_ENV: production
      HOST: 0.0.0.0

    env_file:
      - path: .env
        required: false

    expose:
      - "4173"

    healthcheck:
      test:
        - CMD
        - node
        - -e
        - "fetch('http://127.0.0.1:4173/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

    networks:
      - gods-eye-network

  frontend:
    image: chaitanyathite/gods-eye-frontend:latest
    container_name: gods-eye-frontend
    restart: unless-stopped

    depends_on:
      backend:
        condition: service_healthy

    ports:
      - "8080:80"

    networks:
      - gods-eye-network

networks:
  gods-eye-network:
    driver: bridge
